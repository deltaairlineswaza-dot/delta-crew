DISCORD_TOKEN=replace-with-your-bot-token
# Recommended while testing so slash-command updates appear immediately.
DISCORD_GUILD_ID=123456789012345678
# Optional comma-separated exact names for existing roles that need read access
# to every managed training channel.
TRAINING_GLOBAL_ACCESS_ROLES=Department Management,Human Resources
# Persist this path on your host so ownership survives restarts/deployments.
TRAINING_SETUP_STATE_FILE=data/training_setup_state.json
LOG_LEVEL=INFO

